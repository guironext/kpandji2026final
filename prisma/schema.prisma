generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT_USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id         String           @id @default(uuid())
  email      String
  role       UserRole         @default(CLIENT_USER)
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  invitedBy  String
  acceptedAt DateTime?        @db.Timestamp(3)
  expiresAt  DateTime         @db.Timestamp(3)
  createdAt  DateTime         @default(now()) @db.Timestamp(3)
  user       User?

  @@index([email], map: "Invitation_email_idx")
  @@index([status], map: "Invitation_status_idx")
  @@map("Invitation")
}

model User {
  id                    String                @id @default(uuid())
  clerkUserId           String                @unique
  email                 String                @unique
  fullName              String?
  phone                 String?
  residenceCountry      String?
  role                  UserRole              @default(CLIENT_USER)
  status                UserStatus            @default(PENDING)
  invitationId          String?               @unique
  approvedAt            DateTime?             @db.Timestamp(3)
  approvedBy            String?
  createdAt             DateTime              @default(now()) @db.Timestamp(3)
  updatedAt             DateTime              @updatedAt @db.Timestamp(3)
  invitation            Invitation?           @relation(fields: [invitationId], references: [id])
  prestigeOpportunities PrestigeOpportunity[]
  siraOpportunities     SiraOpportunity[]
  remunerations         Renumeration[]
  comptesVirement       CompteVirement[]

  @@index([status], map: "User_status_idx")
  @@map("User")
}

model EssaiRequest {
  id            String   @id @default(uuid())
  modelIds      Json
  name          String
  email         String
  phone         String
  preferredDate String?
  timeSlot      String?
  message       String?
  createdAt     DateTime @default(now()) @db.Timestamp(3)

  @@index([email], map: "EssaiRequest_email_idx")
  @@index([createdAt], map: "EssaiRequest_createdAt_idx")
  @@map("EssaiRequest")
}

model VisitorMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([email], map: "VisitorMessage_email_idx")
  @@index([createdAt], map: "VisitorMessage_createdAt_idx")
  @@map("VisitorMessage")
}

model VisitorEmail {
  id        String   @id @default(uuid())
  email     String
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([email], map: "VisitorEmail_email_idx")
  @@index([createdAt], map: "VisitorEmail_createdAt_idx")
  @@map("VisitorEmail")
}

model PrivilegeContact {
  id        String   @id @default(uuid())
  name      String
  country   String
  city      String
  phone     String
  email     String
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([email], map: "PrivilegeContact_email_idx")
  @@index([createdAt], map: "PrivilegeContact_createdAt_idx")
  @@map("PrivilegeContact")
}

model EcrireSav {
  id             String   @id @default(uuid())
  name           String
  contact        String
  modeleVehicule String
  panne          String
  localisation   String
  createdAt      DateTime @default(now()) @db.Timestamp(3)

  @@index([createdAt], map: "EcrireSav_createdAt_idx")
  @@map("EcrireSav")
}

model Message_Contact {
  id         String   @id @default(uuid())
  nom        String
  email      String
  telephone  String?
  sujet      String
  texte      String
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  @@index([email], map: "Message_Contact_email_idx")
  @@index([createdAt], map: "Message_Contact_createdAt_idx")
  @@map("Message_Contact")
}

model SiraContact {
  id        String   @id @default(uuid())
  name      String
  country   String
  city      String
  phone     String
  email     String
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([email], map: "SiraContact_email_idx")
  @@index([createdAt], map: "SiraContact_createdAt_idx")
  @@map("SiraContact")
}

model Opportunites {
  id                    String                @id @default(uuid())
  createdAt             DateTime              @default(now()) @db.Timestamp(3)
  siraOpportunities     SiraOpportunity[]
  prestigeOpportunities PrestigeOpportunity[]

  @@map("Opportunites")
}

model PrestigeOpportunity {
  id               String         @id @default(uuid())
  nomFormule       String
  dateDebutFormule DateTime       @db.Timestamp(3)
  dateFin          DateTime       @db.Timestamp(3)
  userId           String
  opportunitesId   String
  createdAt        DateTime       @default(now()) @db.Timestamp(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunites     Opportunites   @relation(fields: [opportunitesId], references: [id], onDelete: Cascade)
  remunerations    Renumeration[]

  @@index([userId], map: "PrestigeOpportunity_userId_idx")
  @@index([opportunitesId], map: "PrestigeOpportunity_opportunitesId_idx")
  @@map("PrestigeOpportunity")
}

model SiraOpportunity {
  id               String         @id @default(uuid())
  nomFormule       String
  dateDebutFormule DateTime       @db.Timestamp(3)
  dateFin          DateTime       @db.Timestamp(3)
  userId           String
  opportunitesId   String
  createdAt        DateTime       @default(now()) @db.Timestamp(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunites     Opportunites   @relation(fields: [opportunitesId], references: [id], onDelete: Cascade)
  remunerations    Renumeration[]

  @@index([userId], map: "SiraOpportunity_userId_idx")
  @@index([opportunitesId], map: "SiraOpportunity_opportunitesId_idx")
  @@map("SiraOpportunity")
}

model CompteVirement {
  id             String         @id @default(uuid())
  compteBancaire String
  numeroCarte    String
  validiteCarte  String
  userId         String
  createdAt      DateTime       @default(now()) @db.Timestamp(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  remunerations  Renumeration[]

  @@index([userId], map: "CompteVirement_userId_idx")
  @@map("CompteVirement")
}

model Renumeration {
  id                    String               @id @default(uuid())
  montant               Decimal              @db.Decimal(12, 2)
  datePayement          DateTime             @db.Timestamp(3)
  siraOpportunityId     String?
  prestigeOpportunityId String?
  compteVirementId      String
  userId                String
  createdAt             DateTime             @default(now()) @db.Timestamp(3)
  siraOpportunity       SiraOpportunity?     @relation(fields: [siraOpportunityId], references: [id], onDelete: SetNull)
  prestigeOpportunity   PrestigeOpportunity? @relation(fields: [prestigeOpportunityId], references: [id], onDelete: SetNull)
  compteVirement        CompteVirement       @relation(fields: [compteVirementId], references: [id], onDelete: Restrict)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Renumeration_userId_idx")
  @@index([compteVirementId], map: "Renumeration_compteVirementId_idx")
  @@index([siraOpportunityId], map: "Renumeration_siraOpportunityId_idx")
  @@index([prestigeOpportunityId], map: "Renumeration_prestigeOpportunityId_idx")
  @@map("Renumeration")
}

