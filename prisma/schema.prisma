// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles a member of the KPANDJI private space can hold.
enum UserRole {
  ADMIN
  PRESTIGE_USER
}

/// Lifecycle of a member account after they accept an invitation.
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Lifecycle of an invitation link issued by an admin.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// A KPANDJI member. Mirrors the Clerk identity and holds the
/// approval state that gates access to the prestige area.
model User {
  id           String      @id @default(cuid())
  clerkUserId  String      @unique
  email        String      @unique
  fullName     String?
  role         UserRole    @default(PRESTIGE_USER)
  status       UserStatus  @default(PENDING)
  invitation   Invitation? @relation(fields: [invitationId], references: [id])
  invitationId String?     @unique
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

/// An invitation link an admin sends before anyone can sign up.
model Invitation {
  id         String           @id @default(cuid())
  email      String
  role       UserRole         @default(PRESTIGE_USER)
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  invitedBy  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  user       User?

  @@index([email])
  @@index([status])
}
